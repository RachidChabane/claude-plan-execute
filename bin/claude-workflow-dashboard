#!/usr/bin/env python3
"""Entry shim for the workflow dashboard server.

For users who prefer symlinking from `bin/` rather than the repo root.
Adds src/ to sys.path so it works without `pip install -e .` (Homebrew
Python blocks via PEP 668).
"""
from __future__ import annotations

import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "src"))

from claude_plan_execute.server import main

if __name__ == "__main__":
    main()
