#!/usr/bin/env python3
"""
claude-plan-execute — Automated plan-review-implement workflow for Claude Code.

For each task in a tasks file:
  1. Plan    — Claude produces a detailed implementation plan.
  2. Review  — A second Claude reviews the plan. If rejected, a third revises it. Loop until approved.
  3. Implement — Claude implements the approved plan and commits.

Usage:
    claude-plan-execute                              # Run all tasks
    claude-plan-execute --task 3                     # Run specific task
    claude-plan-execute --task 3 --skip-to implement # Resume from implementation
    claude-plan-execute --list                       # Show tasks and status
    claude-plan-execute --dry-run                    # Print prompts, don't execute
"""

import sys
from pathlib import Path

# Add src/ to sys.path so we work without `pip install -e .` (Homebrew Python blocks via PEP 668).
sys.path.insert(0, str(Path(__file__).resolve().parent / "src"))

from claude_plan_execute.cli import main

if __name__ == "__main__":
    main()
